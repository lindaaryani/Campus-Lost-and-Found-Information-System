{
  "name": "campusfind",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:init": "tsx scripts/db-init.ts",
    "db:reset": "tsx scripts/db-init.ts --reset",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx tests/scoring.test.ts",
    "test:integration": "tsx --conditions react-server tests/integration.test.ts",
    "test:e2e": "tsx tests/e2e.ts",
    "test:db-setup": "DB_NAME=campusfind_test CONFIRM_RESET=yes tsx scripts/db-init.ts --reset && DB_NAME=campusfind_test tsx scripts/seed.ts",
    "test:perf": "tsx --conditions react-server tests/perf.ts",
    "test:all": "npm run test:unit && npm run test:db-setup && npm run test:integration"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "mysql2": "^3.24.6",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright": "^1.65.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
